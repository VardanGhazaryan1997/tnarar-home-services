# Normalize line endings in the repo; Git converts to the OS default on checkout.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.slnx    text eol=crlf
*.sh      text eol=lf
*.js      text
*.jsx     text
*.scss    text
*.json    text
*.md      text
*.yml     text

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
