<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings, used by CI and the "Code coverage" commands in backend/README.md. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Production code only: the four src projects, not the tests. -->
          <Include>[HomeServices.Domain]*,[HomeServices.Application]*,[HomeServices.Infrastructure]*,[HomeServices.Api]*</Include>
          <!-- Generated by EF Core. -->
          <ExcludeByFile>**/Persistence/Migrations/*.cs</ExcludeByFile>
          <!-- Not CompilerGeneratedAttribute: that would also hide async methods, lambdas and records. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
