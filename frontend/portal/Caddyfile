# Serves the built site and forwards API calls. Settings come from the environment:
#   PORT          where to listen (Railway sets it; 8080 otherwise)
#   API_UPSTREAM  the API's private address, e.g. api.railway.internal:8080
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# The API and the live hub (WebSockets pass through). Railway's edge terminates HTTPS, so tell the API
	# the original scheme: secure cookies depend on it.
	@api path /api/* /hubs/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api.railway.internal:8080} {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * /srv
		# Hashed build files never change; index.html must always be fresh.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
